# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to git.

# Secret used to sign Flask sessions. Any long random string works.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Where the SQLite database file lives (created automatically on first run).
NUTRICARE_DB=instance/nutricare.db

# Port the web server listens on.
PORT=5000

# OPTIONAL: reserved for a future online AI assistant integration.
# If this is empty (the default), the Health Assistant runs its built-in,
# clearly-labelled offline rule-based engine instead. The app never
# pretends an online AI is working.
ASSISTANT_API_KEY=
