{
  "_meta": {
    "version": 1,
    "description": "Canonical class taxonomy for the NutriCare AI Food Scanner. One entry per model output class.",
    "mapping_rule": "'food' names an entry that MUST exist in data/foods.json. 'nutrition_source':'unavailable' means no documented dataset entry exists, so the app must ask the user for values instead of inventing them.",
    "single_label": true,
    "multi_food_note": "The classifier is single-label: it reports the single dominant dish in a photograph. It does not segment or separate multiple dishes on one plate.",
    "merged_classes": [
      {
        "slug": "roti",
        "merged": [
          "roti",
          "chapati",
          "phulka"
        ],
        "why": "Identical flatbread, visually indistinguishable."
      },
      {
        "slug": "pulao",
        "merged": [
          "pulao",
          "jeera rice",
          "veg pulao"
        ],
        "why": "Same rice preparation with minor tempering differences."
      },
      {
        "slug": "dal_plain",
        "merged": [
          "toor dal",
          "moong dal",
          "masoor dal"
        ],
        "why": "Lentil curries look alike; per-lentil distinction is not reliably learnable."
      }
    ],
    "trained_model_coverage": {
      "note": "Classes the shipped checkpoint can actually predict. Keep this in sync with models/food_classifier.pt via its 'classes' field.",
      "source_dataset": "dhruvk2002/food-classifier (20 Indian-majority classes)",
